{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AppSettings": {
    "ApplicationName": "Task API",
    "MaxTasks": 100,
    "IsFeatureXEnabled": true
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=TaskDB;Username=postgres"
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "task-events"
  },

  "AllowedHosts": "*"
}
